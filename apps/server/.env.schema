# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Additional explicit comma-separated HTTPS origins (e.g. a configured alias).
# @required=false @type=string
AUTH_TRUSTED_ORIGINS=
# Verified Resend sender, e.g. Index <accounts@auth.generalpursuit.dev>; not provisioned here.
# @required=false @type=string
AUTH_EMAIL_FROM=
# Server-only. Supply through your deployment secret store.
# @required=false @type=string
RESEND_API_KEY=

# Remote push delivery. Only the exact value "true" enables APNs/Web Push.
# Leave disabled until the provider settings below are configured; desktop polling is independent.
# @required=false @type=string
NOTIFICATIONS_ENABLED=

# Browser Web Push: keep this P-256 key pair stable across deployments.
# Public application-server key: uncompressed 65-byte point, unpadded base64url.
# Sent to authenticated browsers so they can subscribe.
# @required=false @type=string
VAPID_PUBLIC_KEY=

# Private 32-byte scalar, unpadded base64url. Store only as a deployment secret.
# @required=false @type=string
VAPID_PRIVATE_KEY=

# Operator contact URL (mailto:ops@example.com or https://example.com/contact).
# This identifies the sender to push services; it does not send email.
# @required=false @type=string
VAPID_SUBJECT=

# Apple Push Notification service (APNs): obtain credentials from Apple Developer.
# Ten-character signing key identifier associated with the .p8 key below.
# @required=false @type=string
APNS_KEY_ID=

# Ten-character Apple Developer team identifier.
# @required=false @type=string
APNS_TEAM_ID=

# Full PKCS#8 .p8 PEM, including BEGIN/END PRIVATE KEY lines. Deployment secret.
# @required=false @type=string
APNS_PRIVATE_KEY=

# App bundle identifier, e.g. com.generalpursuit.index; must match provisioning.
# @required=false @type=string
APNS_TOPIC=

# sandbox or production, matching the installed app's signed push entitlement.
# @required=false @type=string
APNS_ENVIRONMENT=
