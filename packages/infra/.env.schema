# @import(../../apps/server/, pick=[NODE_ENV, BETTER_AUTH_SECRET])
# @defaultRequired=false
# @defaultSensitive=true
# ---
# @public @type=enum(development, production, test)
NODE_ENV=development

# Release authentication secrets are generated once and kept in Alchemy state.
# This value is only used for local development stages.
# @required=false @type=string(minLength=32)
BETTER_AUTH_SECRET=
# @public @type=url
CORS_ORIGIN=http://localhost:3000

# Required for staging/production. The account prefix before .workers.dev.
# @public
WORKERS_SUBDOMAIN=
# Optional custom hostnames, without https:// or a path.
# @public
WEB_DOMAIN=
# @public
API_DOMAIN=
# Optional comma-separated hostnames that 301 to WEB_DOMAIN, keeping path and query.
# @public
WEB_REDIRECT_DOMAINS=

# Explicit comma-separated additional HTTPS web origins, no wildcard domains.
# @public @type=string
AUTH_TRUSTED_ORIGINS=
# Verified Resend sender. Domain and sender are deployment choices.
# @public @type=string
AUTH_EMAIL_FROM=
# Server-only Resend sending key; never a VITE_ binding.
# @type=string
RESEND_API_KEY=

# Remote push delivery; formats are in apps/server/.env.schema. Only "true" enables it.
# @public @type=string
NOTIFICATIONS_ENABLED=
# Browser Web Push key pair and operator contact. Keep the pair stable per stage.
# @public @type=string
VAPID_PUBLIC_KEY=
# Server-only; never a VITE_ binding.
# @type=string
VAPID_PRIVATE_KEY=
# @public @type=string
VAPID_SUBJECT=
